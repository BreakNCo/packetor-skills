# Payload CMS + humanizer credentials for blog-content-publish
# Copy to .env and fill in ( .env is gitignored )

# Required for cms:draft and cms:link-targets
DATABASE_URI=
PAYLOAD_SECRET=

# Optional humanizers (own accounts / API keys — never Toolzbuy session cookies)
# SMODIN_API_KEY=
# WORDAI_EMAIL=
# WORDAI_API_KEY=
# SPINREWRITER_EMAIL=
# SPINREWRITER_API_KEY=
# WRITEHUMAN_API_KEY=
# STEALTHWRITER_API_KEY=
# QUILLBOT_EMAIL=
# QUILLBOT_PASSWORD=

# Optional: explicit path to a different .env file
# PACKETOR_SKILLS_ENV=
